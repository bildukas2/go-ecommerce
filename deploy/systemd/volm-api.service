[Unit]
Description=Volm Go Ecommerce API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/VolmDemo/go-ecommerce
EnvironmentFile=/var/www/VolmDemo/go-ecommerce/volm.env
ExecStart=/var/www/VolmDemo/go-ecommerce/go-ecommerce-api
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
