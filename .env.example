# API server
PORT=8080

# Database (Postgres)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=ecommerce
DATABASE_URL=postgres://app:app@postgres:5432/ecommerce?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379/0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# Admin auth (session + captcha)
ADMIN_SESSION_TTL_MINUTES=45
TURNSTILE_SECRET_KEY=your_turnstile_secret
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Admin bootstrap seed (used by: go run ./cmd/admin-seed)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Payments (Stripe - test keys)
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key

# Trusted proxies (comma-separated IPs or CIDRs, e.g. 172.16.0.0/12,10.0.0.0/8)
# Leave empty for direct connections (no reverse proxy)
TRUSTED_PROXIES=

# Store settings
CURRENCY=USD
