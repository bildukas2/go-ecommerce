# API server
PORT=8080

# Alternative (More Secure): Unix Socket
# If on comment, it will overwrite ports and will use unit sockets.
# UNIX_SOCKET=/run/volm/volm-api.sock

# Database (Postgres)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=ecommerce
DATABASE_URL=postgres://app:app@postgres:5432/ecommerce?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379/0

# Email (Mailpit local defaults)
EMAIL_DRIVER=mailpit
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_FROM_NAME=Go E-commerce
EMAIL_FROM_ADDR=noreply@local.test
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
API_INTERNAL_URL=http://127.0.0.1:8080

# Admin system update (optional)
PROJECT_ROOT=/var/www/volm_krikstynoms
UPDATE_SCRIPT_PATH=/var/www/volm_krikstynoms/deploy/update-prod.sh

# Admin auth (session + captcha)
ADMIN_SESSION_TTL_MINUTES=45
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Admin bootstrap seed (used by: go run ./cmd/adminseed)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_DISPLAY_NAME=

# Payments (Stripe - test keys)
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key

# Trusted proxies (comma-separated IPs or CIDRs, e.g. 172.16.0.0/12,10.0.0.0/8)
# Leave empty for direct connections (no reverse proxy)
TRUSTED_PROXIES=

# Store settings
CURRENCY=USD
